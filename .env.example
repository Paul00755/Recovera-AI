# ==============================================================================
# Recovera AI - Production & Development Environment Template
# ==============================================================================
# Copy this file to .env (or backend/.env) and populate with your environment values.

# Database Configuration:
# - Production (PostgreSQL): postgresql+psycopg://user:password@host:5432/dbname
# - Local fallback (SQLite): Automatic if PostgreSQL is unreachable, or specify: sqlite:///recovera.db
DATABASE_URL=postgresql+psycopg://recovera:change-me@localhost:5432/recovera

# Security & Authentication
JWT_SECRET=recovera-super-secret-jwt-key-2026-production
JWT_EXPIRE_MINUTES=1440
STAFF_REGISTRATION_CODE=RECOVERA-STAFF-2026

# Network & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=./storage

# Google Gemini API Key for Recovery Assistant AI & Multimodal Analysis
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Hospital Clinical Operations
HOSPITAL_TIMEZONE=Asia/Kolkata
CONSULTATION_MAX_MINUTES=15
APPOINTMENT_DURATION_MINUTES=60

# SMS Gateway Configuration (Dual-Endpoint Auto-Fallback)
ONEPLUS_GATEWAY_URL=http://192.168.1.150:8080
ONEPLUS_GATEWAY_BACKUP_URL=
ONEPLUS_GATEWAY_TOKEN=oneplus-secret-companion-token-2026
ONEPLUS_GATEWAY_ENABLED=false
SMS_RATE_LIMIT_SECONDS=3.0
SMS_DAILY_LIMIT=500
SMS_SENDER_NAME=RecoveraAI
